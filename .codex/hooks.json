{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event session-start --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event user-prompt --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: user-prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event pre-tool --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: pre-tool"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event post-tool --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: post-tool"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event pre-compact --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/constraintloop\" hook --adapter codex --event stop --project \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "ConstraintLoop: stop"
          }
        ]
      }
    ]
  }
}
