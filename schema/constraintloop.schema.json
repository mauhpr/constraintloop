  "$id": "https://raw.githubusercontent.com/mauhpr/constraintloop/main/schema/constraintloop.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "artifact": "#/$defs/ArtifactConstraint",
            "command": "#/$defs/CommandConstraint",
            "metric": "#/$defs/MetricConstraint",
            "ratchet": "#/$defs/RatchetConstraint",
            "rubric": "#/$defs/RubricConstraint"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CommandConstraint"
          },
          {
            "$ref": "#/$defs/MetricConstraint"
          },
          {
            "$ref": "#/$defs/RatchetConstraint"
          },
          {
            "$ref": "#/$defs/ArtifactConstraint"
          },
          {
            "$ref": "#/$defs/RubricConstraint"
          }
        ]
      },
      "title": "Constraints",
      "type": "object"
    },
    "evaluators": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "anthropic": "#/$defs/AnthropicEvaluatorConfig",
            "command": "#/$defs/CommandEvaluatorConfig",
            "openai": "#/$defs/OpenAIEvaluatorConfig"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
