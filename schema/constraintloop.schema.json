      },
      "title": "Loops",
      "type": "object"
    },
    "settings": {
      "$ref": "#/$defs/ContractSettings"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
